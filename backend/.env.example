# Sarvam AI API Key (required)
SARVAM_API_KEY=your_sarvam_api_key_here

# MongoDB (optional - falls back to local JSON storage)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=shikshasetu

# Application settings
APP_ENV=development
LOG_LEVEL=INFO
UPLOAD_DIR=./uploads
AUDIO_CACHE_DIR=./audio_cache
MAX_UPLOAD_SIZE_MB=20
MAX_PAGES=200

# Embedding provider: "local" (TF-IDF, no API cost) or "sarvam" (future)
EMBEDDING_PROVIDER=local
